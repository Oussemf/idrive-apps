{
  "schema": 1,
  "components": [
    {
      "id": "robertn_waze_cluster",
      "kind": "app",
      "path": "apps/robertn_waze_cluster",
      "build": "unit",
      "mguHmi": ["ID7"],
      "requires": { "waze-on-cluster": "0.10.1" },
      "uninstallable": true
    }
  ],
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "exclude": ["robertn_waze_cluster"],
    "mguHmi": ["ID7"],
    "requires": {
      "jap-ridetube-d": "0.3.9",
      "mgu-render": "0.6.11",
      "mgu-inputgate": "1.0.0"
    },
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": ["kit", "LICENSE", "THIRD_PARTY_LICENSES", "oap-sdk"]
    }
  },
  "tools": [
    {
      "id": "waze-on-cluster",
      "path": "store/waze-on-cluster"
    },
    {
      "id": "jap-ridetube-d",
      "path": "store/jap-ridetube-d",
      "title": "YouTube service",
      "description": "Video, audio and search service for YouTube.",
      "mguHmi": ["ID7"],
      "requires": {
        "mgu-deploy": "0.7.0",
        "mgu-python": "1.0.2",
        "jap-node22": "22.23.4",
        "mgu-render": "0.6.11"
      },
      "uninstallable": true
    }
  ]
}
